users ||--o{ tasks : user_id
task_categories |o--o{ tasks : category_id
tasks |o--o{ tasks : parent_task_id
task_types ||--o{ tasks : task_type_code
tasks ||--o{ task_dependencies : predecessor_task_id
tasks ||--o{ task_dependencies : successor_task_id
users ||--o{ work_plans : user_id
work_plans |o--o{ work_plans : previous_plan_id
work_plans ||--o{ plan_items : plan_id
tasks ||--o{ plan_items : task_id
work_sessions |o--o{ plan_items : previous_session_id
plan_items ||--o{ plan_item_reasons : item_id
work_plans ||--o{ plan_warnings : plan_id
tasks |o--o{ plan_warnings : task_id
users ||--o{ work_sessions : user_id
tasks ||--o{ work_sessions : task_id
plan_items |o--o| work_sessions : source_item_id
work_sessions ||--o| session_executions : session_id
session_executions ||--o{ execution_segments : execution_id
users ||--o{ estimation_observations : user_id
tasks |o--o| estimation_observations : task_id
task_types ||--o{ estimation_observations : task_type_code
users ||--o| personal_capacity_profiles : user_id
users ||--o{ task_type_biases : user_id
task_types ||--o{ task_type_biases : task_type_code
users ||--o{ capacity_snapshots : user_id
users ||--o{ risk_assessments : user_id
tasks |o--o{ risk_assessments : task_id
risk_assessments ||--o{ risk_reasons : assessment_id
users ||--o{ notifications : user_id
tasks |o--o{ notifications : task_id
work_sessions |o--o{ notifications : session_id
work_plans |o--o{ notifications : plan_id
users |o--o{ system_job_runs : user_id
legend bottom
  PK primary key, FK foreign key, UQ unique.  work_plans/plan_items are PROPOSALS; work_sessions holds only APPLIED calendar sessions.
  Not persisted by design: what-if scenarios, ad-hoc conflict checks, AI suggestions before the user confirms.
endlegend
@enduml