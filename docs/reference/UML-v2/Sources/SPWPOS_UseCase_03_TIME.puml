@startuml
left to right direction
skinparam dpi 110
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #333333
  ArrowColor #333333
}
skinparam rectangle {
  BackgroundColor #FCFCFC
  BorderColor #555555
}
skinparam ArrowFontSize 10
skinparam nodesep 18
skinparam ranksep 45

title SPWPOS - Use Case Diagram: Time Management (UC27-UC35)
actor "User" as User
rectangle "SPWPOS System - Time Management" {
  usecase "UC27\nSet Weekly Availability" as UC27
  usecase "UC28\nAdd Availability Exception" as UC28
  usecase "UC29\nUpdate Availability Exception" as UC29
  usecase "UC30\nRemove Availability Exception" as UC30
  usecase "UC31\nCreate Fixed Event" as UC31
  usecase "UC32\nUpdate Fixed Event" as UC32
  usecase "UC33\nDelete Fixed Event" as UC33
  usecase "UC34\nView Personal Calendar" as UC34
  usecase "UC35\nSet Work Preferences" as UC35
}
rectangle "Referenced from other subsystems" #F4F4F4 {
  usecase "UC45\nGenerate Reschedule Proposal" as UC45 #E8E8E8;line.dashed;line:666666
}
User --> UC27
User --> UC28
User --> UC29
User --> UC30
User --> UC31
User --> UC32
User --> UC33
User --> UC34
User --> UC35
UC45 ..> UC28 : <<extend>>\n{availability changed}
UC45 ..> UC32 : <<extend>>\n{event changed}
legend bottom
  <<include>> : base use case ALWAYS performs the included use case (arrow points to included).
  <<extend>>  : extending use case is OPTIONAL / conditional (arrow points to base; {condition} shown).
  Solid line : association (actor takes part).  Grey dashed use case : defined in another subsystem.
  Every User use case presupposes a logged-in session (UC02) except UC01, UC02, UC04, UC05; this is a
  precondition, not an <<include>>.
endlegend
@enduml